DATABASE_URL=postgresql://quizboard:quizboard@localhost:5432/quizboard
JWT_SECRET=replace-this-with-a-long-random-secret
BACKEND_PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Required only when running the administrator provisioning command.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=QuizAdmin
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
# Optional path to a JSON file with exactly four unique administrator records.
ADMIN_SEED_USERS_FILE=./admin-seed-users.json
