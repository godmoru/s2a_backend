DATABASE_URL=postgresql://quizboard:quizboard@localhost:5432/quizboard
JWT_SECRET=replace-this-with-a-long-random-secret
BACKEND_PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Required only when running the administrator provisioning command.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=QuizAdmin
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
# Optional path to a JSON file with exactly four unique administrator records.
ADMIN_SEED_USERS_FILE=./admin-seed-users.json

# --- Production / deployment ---
NODE_ENV=development
# Comma-separated list of allowed browser origins
# FRONTEND_ORIGIN=https://app.example.com
# Set to 1 when behind a reverse proxy / load balancer
# TRUST_PROXY=1
# Max auth requests per IP per 15 minutes
# AUTH_RATE_LIMIT=30
# SMTP for password reset emails (without it, links are logged to the console)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="S2Answer <no-reply@example.com>"
# docker-compose only
# POSTGRES_PASSWORD=change-me
